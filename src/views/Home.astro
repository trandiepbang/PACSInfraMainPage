---
// Home page, rendered at / and /zh-tw/. The language comes from the URL.
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Guarantees from '../components/Guarantees.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SystemOverview from '../components/SystemOverview.astro';
import CapacitySummary from '../components/CapacitySummary.astro';
import ProductScreens from '../components/ProductScreens.astro';
import FoundingBanner from '../components/FoundingBanner.astro';
import StackOverview from '../components/StackOverview.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import StructuredData from '../components/StructuredData.astro';
import Founder from '../components/Founder.astro';
import FeatureTable from '../components/FeatureTable.astro';
import { founder } from '../data/founder';
import { getPricing, site } from '../config';
import { billingLabel, formatPrice, lowestPrice } from '../lib/format';
import { product } from '../data/product';
import { capacity } from '../data/capacity';
import { getLocale, localizePath } from '../i18n';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.url);
const t = ui[locale];
const h = t.home;
const { summary, pixelCaveat } = product[locale];
const pricing = getPricing(locale);
const cap = capacity[locale];

// The de-identification answer must carry the pixel caveat wherever it appears.
const faq = h.faq.map((f, i) => (i === 1 ? { ...f, a: `${f.a} ${pixelCaveat}` } : f));
const description = h.metaDescription.replace('{price}', lowestPrice());
---

<BaseLayout fullTitle={h.metaTitle} description={description}>
  <StructuredData faq={faq} />
  <!-- Hero -->
  <section class="border-b border-line dark:border-line-dark">
    <div class="container-page py-20 sm:py-28">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight sm:text-6xl">{h.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl dark:text-slate-300">
        {h.lead}{locale === 'en' ? ' ' : ''}{summary}
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={site.demoUrl} class="btn-primary">{t.cta.demo}</a>
        <a href={localizePath('/pricing', locale)} class="btn-secondary">{t.cta.pricing}</a>
        <a href={site.bookingUrl} class="btn-secondary">{t.cta.call}</a>
      </div>
      <p class="mt-5 inline-flex max-w-2xl gap-2.5 rounded-lg border border-amber-300 bg-amber-50 px-3.5 py-2.5 text-sm font-medium text-amber-900 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-100">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true" class="mt-px shrink-0"><path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 4a1 1 0 0 1 1 1v3.5a1 1 0 1 1-2 0V7a1 1 0 0 1 1-1Zm0 8.5a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2Z" /></svg>
        <span>{h.demoLimitedShort}</span>
      </p>
    </div>
  </section>

  <Section id="guarantees" eyebrow={h.guaranteesEyebrow} title={h.guaranteesTitle}>
    <Guarantees />
  </Section>

  <Section id="features" tone="muted" eyebrow={h.featuresEyebrow} title={h.featuresTitle}>
    <FeatureGrid />
  </Section>

  <Section id="architecture" eyebrow={h.overviewEyebrow} title={h.overviewTitle} intro={h.overviewIntro}>
    <SystemOverview />
  </Section>

  <Section id="capacity" tone="muted" eyebrow={cap.eyebrow} title={cap.title} intro={cap.intro}>
    <CapacitySummary />
  </Section>

  <Section id="screenshots" eyebrow={h.screenshotsEyebrow} title={h.screenshotsTitle}>
    <ProductScreens />
    <div class="mt-10 flex flex-col gap-4 rounded-xl border border-amber-300 bg-amber-50 px-5 py-4 sm:flex-row sm:items-center sm:justify-between dark:border-amber-700/60 dark:bg-amber-950/40">
      <p class="flex gap-3 text-amber-900 dark:text-amber-100">
        <svg viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true" class="mt-0.5 shrink-0"><path d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 4a1 1 0 0 1 1 1v3.5a1 1 0 1 1-2 0V7a1 1 0 0 1 1-1Zm0 8.5a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2Z" /></svg>
        <span><strong class="font-semibold">{h.demoLimitedTitle}</strong> {h.demoLimitedText}</span>
      </p>
      <a href={site.bookingUrl} class="btn-primary shrink-0">{t.cta.call}</a>
    </div>
  </Section>

  <Section id="stack" tone="muted" eyebrow={h.stackEyebrow} title={h.stackTitle}>
    <StackOverview />
  </Section>

  <Section id="pricing" eyebrow={h.pricingEyebrow} title={h.pricingTitle} intro={pricing.licenceSummary}>
    <div class="space-y-6">
      <FoundingBanner />
      <ul class="grid gap-4 md:grid-cols-[repeat(auto-fit,minmax(16rem,1fr))]">
        {pricing.tiers.map((tier) => (
          <li class:list={['card', tier.highlight && 'border-2 border-accent dark:border-accent-dark']}>
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-semibold">{tier.name}</h3>
              {tier.badge && <span class="text-xs font-semibold text-accent dark:text-accent-dark">{tier.badge}</span>}
            </div>
            <p class="mt-3">
              <span class="text-3xl font-semibold tracking-tight">{formatPrice(tier.price)}</span>
              <span class="ml-1 text-sm text-slate-500 dark:text-slate-400">{billingLabel(tier.billing, locale)}</span>
            </p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{tier.description}</p>
            {tier.callout && <p class="mt-3 text-sm font-semibold text-accent dark:text-accent-dark">✓ {tier.callout}</p>}
            {tier.renewal && <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">{t.renewalNote.replace('{price}', formatPrice(tier.renewal))}</p>}
          </li>
        ))}
        <li class="card border-dashed">
          <h3 class="font-semibold">{t.pricing.addOnTitle.replace('{name}', pricing.addOn.name)}</h3>
          <p class="mt-3">
            <span class="text-3xl font-semibold tracking-tight">+{formatPrice(pricing.addOn.price)}</span>
          </p>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{pricing.addOn.description}</p>
        </li>
      </ul>
      <FeatureTable />
      <a href={localizePath('/pricing', locale)} class="link inline-block text-sm">{h.comparePlans} &rarr;</a>
    </div>
  </Section>

  <Section id="founder" tone="muted" eyebrow={founder[locale].eyebrow} title={founder[locale].title}>
    <Founder />
  </Section>

  <Section id="faq" eyebrow={h.faqEyebrow} title={h.faqTitle}>
    <Faq items={faq} />
    <p class="mt-6 text-sm text-slate-600 dark:text-slate-400">
      {h.faqFooterBefore} <a href={localizePath('/pricing#faq', locale)} class="link">{h.faqFooterLink}</a>{h.faqFooterAfter}
    </p>
  </Section>

  <CtaBand />
</BaseLayout>
