---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import FoundingBanner from '../components/FoundingBanner.astro';
import PricingCards from '../components/PricingCards.astro';
import Faq from '../components/Faq.astro';
import { getPricing, site } from '../config';
import { formatPrice, pricingSummary } from '../lib/format';
import { getLocale, localizePath } from '../i18n';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.url);
const t = ui[locale].pricing;
const pricing = getPricing(locale);
const description =
  locale === 'en'
    ? `${site.name} pricing: ${pricingSummary(locale)}. ${pricing.licenceSummary.trim()}`
    : `${site.name} 價格方案：${pricingSummary(locale)}。${pricing.licenceSummary.trim()}`;
---

<BaseLayout title={t.metaTitle} description={description}>
  <PageHeader eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

  <Section>
    <div class="space-y-12">
      <FoundingBanner />
      <PricingCards />
      <div class="mx-auto max-w-4xl rounded-xl border border-dashed border-line px-6 py-5 text-center dark:border-line-dark">
        <p class="font-semibold">{t.addOnTitle}</p>
        <p class="mt-1 text-slate-600 dark:text-slate-300">{t.addOnText.replace('{rate}', pricing.integrationDayRate ? formatPrice(pricing.integrationDayRate) : '[PLACEHOLDER]')}</p>
      </div>
      <div class="flex flex-col items-center gap-4 text-center">
        <p class="text-lg text-slate-600 dark:text-slate-300">{t.contactText}</p>
        <a href={localizePath('/contact', locale)} class="btn-primary px-8 py-3 text-base">{t.contactButton}</a>
      </div>
    </div>
  </Section>

  <Section id="licence" tone="muted" title={t.licenceTitle}>
    <p class="max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">{pricing.licenceSummary}</p>
    <p class="mt-4 text-sm"><a href={localizePath('/licence', locale)} class="link">{t.licenceLink} &rarr;</a></p>
  </Section>

  {pricing.faq.length > 0 && (
    <Section id="faq" title={t.faqTitle}>
      <Faq items={pricing.faq} />
    </Section>
  )}
</BaseLayout>
