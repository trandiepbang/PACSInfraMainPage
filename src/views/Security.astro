---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import PixelCaveat from '../components/PixelCaveat.astro';
import CtaBand from '../components/CtaBand.astro';
import { getLocale } from '../i18n';
import { ui } from '../i18n/ui';

const s = ui[getLocale(Astro.url)].security;
---

<BaseLayout title={s.metaTitle} description={s.metaDescription}>
  <PageHeader eyebrow={s.eyebrow} title={s.title} intro={s.intro} />

  <Section id="isolation" title={s.isolationTitle}>
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="space-y-4 leading-7 text-slate-600 dark:text-slate-300">
        <p>{s.isolationP1}</p>
        <p>{s.isolationP2Before} <strong class="text-ink dark:text-white">{s.isolationP2Strong}</strong> {s.isolationP2After}</p>
      </div>
      <ul class="space-y-3">
        {s.isolationCards.map((c) => (
          <li class="card p-5"><p class="font-semibold">{c.t}</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{c.b}</p></li>
        ))}
      </ul>
    </div>
  </Section>

  <Section id="api-gated" tone="muted" title={s.gatedTitle} intro={s.gatedIntro}>
    <ArchitectureDiagram />
  </Section>

  <Section id="de-identification" title={s.deidTitle}>
    <div class="space-y-10">
      <ol class="grid gap-4 md:grid-cols-4">
        {s.pipeline.map((p, i) => (
          <li class="card p-5">
            <p class="text-sm font-semibold text-accent dark:text-accent-dark">{s.step} {i + 1}</p>
            <p class="mt-1 text-lg font-semibold">{p.step}</p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{p.text}</p>
          </li>
        ))}
      </ol>

      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h3 class="text-xl font-semibold">{s.removedTitle}</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-7 text-slate-600 dark:text-slate-300">
            {s.removed.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold">{s.waysTitle}</h3>
          <dl class="mt-4 space-y-4">
            {s.ways.map((w) => (
              <div class="card p-5"><dt class="font-semibold">{w.t}</dt><dd class="mt-1 text-sm text-slate-600 dark:text-slate-400">{w.b}</dd></div>
            ))}
          </dl>
        </div>
      </div>

      <div class="max-w-3xl">
        <PixelCaveat />
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{s.burnedIn}</p>
      </div>
    </div>
  </Section>

  <Section id="break-the-glass" tone="muted" title={s.btgTitle}>
    <div class="grid gap-10 lg:grid-cols-2">
      <p class="leading-7 text-slate-600 dark:text-slate-300">{s.btgText}</p>
      <ol class="space-y-3 text-sm">
        {s.btgSteps.map((step, i) => <li class="card p-4"><strong>{i + 1}.</strong> {step}</li>)}
      </ol>
    </div>
  </Section>

  <Section id="audit" title={s.auditTitle}>
    <div class="grid gap-10 lg:grid-cols-2">
      <p class="leading-7 text-slate-600 dark:text-slate-300">{s.auditText}</p>
      <ul class="space-y-3 text-sm">
        {s.auditPoints.map((p) => <li class="card p-4">{p}</li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title={s.ctaTitle} text={s.ctaText} />
</BaseLayout>
