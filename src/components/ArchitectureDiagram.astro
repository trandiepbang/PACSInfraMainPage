---
// Request path: Browser -> PACSinfra API (permissions + audit) -> Orthanc on a private network.
import { getLocale } from '../i18n';
import { ui } from '../i18n/ui';

const t = ui[getLocale(Astro.url)].diagram;
const box = 'card flex-1 p-5 text-center';
---

<figure class="rounded-xl border border-line bg-mist p-4 sm:p-8 dark:border-line-dark dark:bg-night-raised/50">
  <div class="flex flex-col items-stretch gap-3 md:flex-row md:items-center">
    <div class={box}>
      <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{t.publicLabel}</p>
      <p class="mt-1 text-lg font-semibold">{t.browser}</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{t.staff}</p>
    </div>

    <div class="flex items-center justify-center text-slate-400" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" class="rotate-90 md:rotate-0"><path d="M4 12h15M14 6l6 6-6 6" /></svg>
    </div>

    <div class:list={[box, 'border-2 border-accent dark:border-accent-dark']}>
      <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">{t.onlyWay}</p>
      <p class="mt-1 text-lg font-semibold">{t.api}</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-2 text-xs font-medium">
        <li class="rounded-full bg-accent/10 px-2.5 py-1 text-accent dark:bg-accent-dark/15 dark:text-accent-dark">{t.checks}</li>
        <li class="rounded-full bg-accent/10 px-2.5 py-1 text-accent dark:bg-accent-dark/15 dark:text-accent-dark">{t.records}</li>
      </ul>
    </div>

    <div class="flex items-center justify-center text-slate-400" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" class="rotate-90 md:rotate-0"><path d="M4 12h15M14 6l6 6-6 6" /></svg>
    </div>

    <div class="flex-1 rounded-xl border-2 border-dashed border-slate-400 p-2 dark:border-slate-600">
      <p class="px-2 pt-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">{t.privateNet}</p>
      <div class="card mt-2 p-5 text-center">
        <p class="text-lg font-semibold">Orthanc</p>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{t.orthancSub}</p>
      </div>
    </div>
  </div>
  <figcaption class="mt-6 text-center text-sm text-slate-600 dark:text-slate-400">
    {t.caption}
  </figcaption>
</figure>
