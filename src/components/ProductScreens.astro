---
// Product screenshots in a browser-style frame: the viewer full width on top, three screens in a
// row below. Images live in public/screenshots, cropped to the app (no real browser
// chrome) and exported as 2000px WebP.
import { getLocale } from '../i18n';
import { ui } from '../i18n/ui';

const t = ui[getLocale(Astro.url)].home;

const featured = { src: '/screenshots/viewer.webp', width: 2000, height: 1146, ...t.shots[0] };
const side = [
  { src: '/screenshots/studies.webp', width: 2000, height: 1146, ...t.shots[3] },
  { src: '/screenshots/audit.webp', width: 2000, height: 1146, ...t.shots[2] },
  { src: '/screenshots/dashboard.webp', width: 2000, height: 1146, ...t.shots[1] },
];
---

<div class="grid items-start gap-x-6 gap-y-10 md:grid-cols-3">
  {[{ ...featured, big: true }, ...side.map((s) => ({ ...s, big: false }))].map((s) => (
    <figure class:list={[s.big && 'md:col-span-3']}>
      <div class="overflow-hidden rounded-xl border border-line bg-night shadow-xl shadow-slate-900/10 ring-1 ring-black/5 dark:border-line-dark dark:shadow-black/40">
        <div class="flex items-center gap-2 border-b border-white/10 bg-[#1b1f2b] px-3 py-2" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 truncate rounded-md bg-white/10 px-3 py-0.5 text-[11px] text-slate-300">demo.pacsinfra.com</span>
        </div>
        <img src={s.src} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async" class="block h-auto w-full" />
      </div>
      <figcaption class:list={[s.big ? 'mt-4' : 'mt-3']}>
        <p class="font-semibold">{s.title}</p>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{s.text}</p>
      </figcaption>
    </figure>
  ))}
</div>
