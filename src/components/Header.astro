---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle';
import LanguageSwitch from './LanguageSwitch.astro';
import { site } from '../config';
import { mainNav, useCaseLinks } from '../data/nav';
import { getLocale, localizePath } from '../i18n';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.url);
const t = ui[locale];
const nav = mainNav(locale);
const useCases = useCaseLinks(locale);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '');
  return path === h || path.startsWith(`${h}/`);
};
const navLink =
  'rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:text-accent dark:text-slate-300 dark:hover:text-accent-dark';
const activeLink = 'text-accent dark:text-accent-dark';
---

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur dark:border-line-dark dark:bg-night/95">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={localizePath('/', locale)} aria-label={`${site.name} ${t.nav.home}`} class="shrink-0">
      <Logo />
    </a>

    <nav aria-label={t.nav.main} class="hidden items-center gap-1 lg:flex">
      <details class="group relative">
        <summary class:list={[navLink, 'flex cursor-pointer items-center gap-1', path.includes('/use-cases') && activeLink]}>
          {t.nav.useCases}
          <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true" class="transition group-open:rotate-180"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z" /></svg>
        </summary>
        <div class="absolute left-0 mt-2 w-52 rounded-lg border border-line bg-white p-2 shadow-sm dark:border-line-dark dark:bg-night-raised">
          {useCases.map((l) => (
            <a href={l.href} class="block rounded-md px-3 py-2 text-sm hover:bg-mist dark:hover:bg-night">{l.label}</a>
          ))}
        </div>
      </details>
      {nav.map((l) => (
        <a href={l.href} class:list={[navLink, isActive(l.href) && activeLink]} aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.bookingUrl} class="btn-primary hidden sm:inline-flex">{t.cta.call}</a>
      <LanguageSwitch />
      <ThemeToggle client:load labels={t.theme} />
      <details class="group lg:hidden">
        <summary class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-md border border-line dark:border-line-dark" aria-label={t.nav.menu}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <nav aria-label={t.nav.mobile} class="absolute inset-x-0 top-16 border-b border-line bg-white px-4 py-4 dark:border-line-dark dark:bg-night">
          <ul class="space-y-1">
            {nav.map((l) => (
              <li><a href={l.href} class="block rounded-md px-3 py-2 font-medium hover:bg-mist dark:hover:bg-night-raised">{l.label}</a></li>
            ))}
            <li class="px-3 pt-3 text-xs font-semibold tracking-wide text-slate-500 uppercase">{t.nav.useCases}</li>
            {useCases.map((l) => (
              <li><a href={l.href} class="block rounded-md px-3 py-2 hover:bg-mist dark:hover:bg-night-raised">{l.label}</a></li>
            ))}
            <li class="pt-3"><a href={site.bookingUrl} class="btn-primary w-full">{t.cta.call}</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
