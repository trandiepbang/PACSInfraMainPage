---
// Compact tech-stack summary for the homepage and Developers page. Full detail on /technology.
import { getLocale, localizePath } from '../i18n';
import { ui } from '../i18n/ui';
import { techStack } from '../data/tech-stack';

const locale = getLocale(Astro.url);
const { stack, storage, stackIntro } = techStack[locale];
const parts = [
  ...stack.map((s) => ({ name: s.name, version: s.language, sub: s.tagline })),
  ...storage.map((s) => ({ name: s.name, version: undefined, sub: s.summary.split(/[.。]/)[0] })),
];
---

<div>
  <p class="max-w-3xl text-lg text-slate-600 dark:text-slate-300">{stackIntro}</p>
  <ul class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
    {parts.map((p) => (
      <li class="card p-5">
        <p class="font-semibold">{p.name}</p>
        {p.version && <p class="mt-0.5 text-sm font-medium text-accent dark:text-accent-dark">{p.version}</p>}
        {p.sub && <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{p.sub}</p>}
      </li>
    ))}
  </ul>
  <a href={localizePath('/technology', locale)} class="link mt-6 inline-block text-sm">{ui[locale].common.fullStack} &rarr;</a>
</div>
