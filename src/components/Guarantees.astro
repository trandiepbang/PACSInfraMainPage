---
import PixelCaveat from './PixelCaveat.astro';
import { guarantees } from '../data/product';
---

<div class="grid gap-6 md:grid-cols-2">
  {guarantees.map((g) => (
    <article class="card flex flex-col border-t-4 border-t-accent p-8 dark:border-t-accent-dark">
      <h3 class="text-2xl font-semibold tracking-tight">{g.title}</h3>
      <p class="mt-4 flex-1 leading-7 text-slate-600 dark:text-slate-300">{g.body}</p>
      {g.caveat && <div class="mt-5"><PixelCaveat /></div>}
      <a href={g.href} class="link mt-6 text-sm">How it works &rarr;</a>
    </article>
  ))}
</div>
