---
import PixelCaveat from './PixelCaveat.astro';
import { getLocale, localizePath } from '../i18n';
import { ui } from '../i18n/ui';
import { product } from '../data/product';

const locale = getLocale(Astro.url);
const { guarantees } = product[locale];
---

<div class="grid gap-6 md:grid-cols-2">
  {guarantees.map((g) => (
    <article class="card flex flex-col border-t-4 border-t-accent p-8 dark:border-t-accent-dark">
      <h3 class="text-2xl font-semibold tracking-tight">{g.title}</h3>
      <p class="mt-4 flex-1 leading-7 text-slate-600 dark:text-slate-300">{g.body}</p>
      {g.caveat && <div class="mt-5"><PixelCaveat /></div>}
      <a href={localizePath(g.href, locale)} class="link mt-6 text-sm">{ui[locale].common.howItWorks} &rarr;</a>
    </article>
  ))}
</div>
