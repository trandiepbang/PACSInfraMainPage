---
import Logo from './Logo.astro';
import { site } from '../config';
import { mainNav, useCaseLinks } from '../data/nav';
import { getLocale, localizePath } from '../i18n';
import { ui } from '../i18n/ui';

const locale = getLocale(Astro.url);
const t = ui[locale];
const columns = [
  { title: t.footer.product, links: mainNav(locale) },
  { title: t.footer.useCases, links: useCaseLinks(locale) },
  {
    title: t.footer.company,
    links: [
      { href: localizePath('/contact', locale), label: t.footer.contact },
      { href: '/terms', label: t.footer.terms },
      { href: '/privacy', label: t.footer.privacy },
      { href: '/refund', label: t.footer.refunds },
      { href: '/licence', label: t.footer.licence },
    ],
  },
];
const tagline = t.common.tagline || site.tagline;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-mist dark:border-line-dark dark:bg-night-raised">
  <div class="container-page grid gap-10 py-12 md:grid-cols-4">
    <div>
      <a href={localizePath('/', locale)} aria-label={`${site.name} ${t.nav.home}`}><Logo size="sm" /></a>
      <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">{tagline}</p>
      <p class="mt-4 text-sm"><a class="link" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></p>
    </div>
    {columns.map((col) => (
      <nav aria-label={col.title}>
        <h2 class="text-sm font-semibold">{col.title}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {col.links.map((l) => (
            <li><a href={l.href} class="text-slate-600 hover:text-accent dark:text-slate-400 dark:hover:text-accent-dark">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container-page flex flex-col gap-3 border-t border-line py-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:border-line-dark dark:text-slate-400">
    <p>&copy; {year} {site.name}{locale !== 'en' && <span class="ml-2">· {t.footer.englishOnly}</span>}</p>
    <ul class="flex gap-4">
      {site.social.map((s) => (
        <li><a href={s.href} class="hover:text-accent dark:hover:text-accent-dark" rel="me noopener">{s.label}</a></li>
      ))}
    </ul>
  </div>
</footer>
