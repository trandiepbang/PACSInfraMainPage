---
// "What's included": every feature and service, ticked against the plan and the add-on.
// Rows come from src/data/product.ts; the plan and add-on prices from pricing.yaml.
import { getPricing } from '../config';
import { getLocale } from '../i18n';
import { ui } from '../i18n/ui';
import { product } from '../data/product';
import { formatPrice } from '../lib/format';
import DiagramIcon from './DiagramIcon.astro';

const locale = getLocale(Astro.url);
const t = ui[locale].pricing;
const pricing = getPricing(locale);
const plan = pricing.tiers[0];
const { table } = product[locale];
---

<div class="overflow-x-auto rounded-xl border border-line dark:border-line-dark">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">{t.tableTitle}</caption>
    <thead class="bg-slate-50 dark:bg-white/5">
      <tr>
        <th scope="col" class="px-4 py-3 font-semibold sm:px-6">{t.tableTitle}</th>
        <th scope="col" class="px-3 py-3 text-center font-semibold">
          <span class="block">{plan.name}</span>
          <span class="block text-xs font-normal text-slate-500 dark:text-slate-400">{formatPrice(plan.price)}</span>
        </th>
        <th scope="col" class="px-3 py-3 text-center font-semibold sm:px-6">
          <span class="block">{t.addOnShort}</span>
          <span class="block text-xs font-normal text-slate-500 dark:text-slate-400">+{formatPrice(pricing.addOn.price)}</span>
        </th>
      </tr>
    </thead>
    <tbody>
      {table.map((row) =>
        'group' in row ? (
          <tr class="border-t border-line dark:border-line-dark">
            <th scope="colgroup" colspan="3" class="px-4 pb-2 pt-5 text-xs font-semibold uppercase tracking-wider text-accent sm:px-6 dark:text-accent-dark">{row.group}</th>
          </tr>
        ) : (
          <tr class="border-t border-line/60 dark:border-line-dark/60">
            <th scope="row" class="px-4 py-2.5 font-normal sm:px-6">
              <span class="flex items-center gap-3">
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-accent/10 text-accent dark:bg-accent-dark/15 dark:text-accent-dark">
                  <DiagramIcon name={row.icon} size={16} />
                </span>
                {row.label}
              </span>
            </th>
            {row.quoted ? (
              <td colspan="2" class="px-3 py-2.5 text-center text-xs font-medium text-slate-500 sm:px-6 dark:text-slate-400">{t.quoted}</td>
            ) : [row.plan, row.addOn].map((on) => (
              <td class="px-3 py-2.5 text-center">
                {on ? (
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" role="img" aria-label={t.included} class="inline text-accent dark:text-accent-dark"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" /></svg>
                ) : (
                  <span class="text-slate-300 dark:text-slate-600" aria-label={t.notIncluded}>&ndash;</span>
                )}
              </td>
            ))}
          </tr>
        ),
      )}
    </tbody>
  </table>
</div>
