---
// Renders every tier from pricing.yaml in order. Layout adapts to 1-3 tiers.
import { getPricing } from '../config';
import { getLocale } from '../i18n';
import { billingLabel, formatPrice } from '../lib/format';

const locale = getLocale(Astro.url);
const pricing = getPricing(locale);

const layout: Record<number, string> = {
  1: 'max-w-md mx-auto',
  2: 'md:grid-cols-2 max-w-4xl mx-auto',
  3: 'md:grid-cols-2 lg:grid-cols-3',
};
---

<div class:list={['grid gap-6', layout[pricing.tiers.length]]}>
  {pricing.tiers.map((tier) => (
    <article
      id={tier.id}
      class:list={[
        'card relative flex flex-col p-8',
        tier.highlight && 'border-2 border-accent dark:border-accent-dark',
      ]}
    >
      {tier.badge && (
        <p class="absolute -top-3 left-8 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white dark:bg-accent-dark dark:text-night">
          {tier.badge}
        </p>
      )}
      <h3 class="text-xl font-semibold">{tier.name}</h3>
      <p class="mt-2 text-slate-600 dark:text-slate-400">{tier.description}</p>
      {tier.callout && (
        <p class="mt-5 flex items-center gap-2.5 rounded-lg border border-accent/40 bg-accent/10 px-4 py-3 font-semibold text-accent dark:border-accent-dark/40 dark:bg-accent-dark/15 dark:text-accent-dark">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3ZM9 12l2 2 4-4" /></svg>
          {tier.callout}
        </p>
      )}
      <p class="mt-6 flex items-baseline gap-2">
        <span class="text-4xl font-semibold tracking-tight">{formatPrice(tier.price)}</span>
        <span class="text-sm text-slate-500 dark:text-slate-400">{billingLabel(tier.billing, locale)}</span>
      </p>
      <ul class="mt-6 flex-1 space-y-3 text-sm">
        {tier.features.map((f) => (
          <li class="flex gap-3">
            <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true" class="mt-0.5 shrink-0 text-accent dark:text-accent-dark"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" /></svg>
            <span>{f}</span>
          </li>
        ))}
      </ul>
      {tier.note && <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">{tier.note}</p>}
    </article>
  ))}
</div>
