---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<div class="border-b border-line bg-mist dark:border-line-dark dark:bg-night-raised/50">
  <div class="container-page py-14 sm:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    {intro && <p class="mt-5 max-w-2xl text-lg text-slate-600 dark:text-slate-300">{intro}</p>}
    <slot />
  </div>
</div>
