---
// Brand lockup: inline mark + "PACS" (regular) + "infra" (bold, accent). Used in the site header,
// footer and the Starlight docs header. Styles are scoped CSS (not Tailwind) so it works in both.
interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---

<span class:list={['logo', size]}>
  <svg class="mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect x="5" y="6" width="26" height="20" rx="4" opacity="0.3"></rect>
    <rect x="11" y="13" width="26" height="20" rx="4" opacity="0.6"></rect>
    <rect x="17" y="20" width="26" height="20" rx="4"></rect>
  </svg>
  <span class="word" translate="no"><span class="pacs">PACS</span><span class="infra">infra</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo.sm {
    font-size: 1.125rem;
  }
  .mark {
    width: 1.6em;
    height: 1.6em;
    flex: none;
    fill: #0f6e75;
  }
  .pacs {
    font-weight: 400;
    color: #16202a;
  }
  .infra {
    font-weight: 700;
    color: #0f6e75;
  }
  :global([data-theme='dark']) .mark,
  :global([data-theme='dark']) .infra {
    fill: #5cc6c0;
    color: #5cc6c0;
  }
  :global([data-theme='dark']) .pacs {
    color: #c9d2d7;
  }
</style>
