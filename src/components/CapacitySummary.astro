---
// Capacity and scaling: the headline figures and the machine they were measured on.
import { getLocale } from '../i18n';
import { capacity } from '../data/capacity';

const c = capacity[getLocale(Astro.url)];
---

<div>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {c.stats.map((s) => (
      <li class="card flex flex-col p-5">
        <p class="text-3xl font-semibold tracking-tight text-accent dark:text-accent-dark">{s.value}</p>
        <p class="mt-1 font-semibold">{s.label}</p>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">{s.body}</p>
      </li>
    ))}
  </ul>
  <p class="mt-5 text-sm text-slate-500 dark:text-slate-400">{c.note}</p>
</div>
