---
// Capacity and scaling: the headline figures and the machine they were measured on.
import { getLocale } from '../i18n';
import { capacity } from '../data/capacity';
import { site } from '../config';
import DiagramIcon from './DiagramIcon.astro';

const c = capacity[getLocale(Astro.url)];
---

<div>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {c.stats.map((s) => (
      <li class="card flex flex-col p-5">
        <p class="text-3xl font-semibold tracking-tight text-accent dark:text-accent-dark">{s.value}</p>
        <p class="mt-1 font-semibold">{s.label}</p>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">{s.body}</p>
      </li>
    ))}
  </ul>
  <p class="mt-5 text-sm text-slate-500 dark:text-slate-400">{c.note}</p>
  <div class="mt-10 flex flex-col gap-5 rounded-xl border-2 border-accent/40 bg-white p-6 sm:flex-row sm:items-center dark:border-accent-dark/40 dark:bg-night">
    <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent dark:bg-accent-dark/15 dark:text-accent-dark">
      <DiagramIcon name="server" size={24} />
    </span>
    <div class="flex-1">
      <p class="text-lg font-semibold">{c.expertTitle}</p>
      <p class="mt-1.5 leading-7 text-slate-600 dark:text-slate-300">{c.expertText}</p>
    </div>
    <a href={site.bookingUrl} class="btn-primary shrink-0">{c.expertCta}</a>
  </div>
</div>
