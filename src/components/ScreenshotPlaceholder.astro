---
// TODO: replace each placeholder with a real screenshot (e.g. <img> from /public/screenshots).
import { getLocale } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  label: string;
}
const { label } = Astro.props;
const t = ui[getLocale(Astro.url)].common;
---

<figure>
  <div class="flex aspect-[16/10] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-mist text-sm text-slate-500 dark:border-slate-600 dark:bg-night-raised dark:text-slate-400">
    {t.screenshot}
  </div>
  <figcaption class="mt-3 text-sm font-medium">{label}</figcaption>
</figure>
