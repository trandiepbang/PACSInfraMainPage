---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  tone?: 'plain' | 'muted';
  class?: string;
}
const { id, eyebrow, title, intro, tone = 'plain', class: className } = Astro.props;
---

<section id={id} class:list={['scroll-mt-20 py-16 sm:py-20', tone === 'muted' && 'bg-mist dark:bg-night-raised/50', className]}>
  <div class="container-page">
    {(eyebrow || title || intro) && (
      <div class="mb-10 max-w-3xl">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>}
        {intro && <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{intro}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
