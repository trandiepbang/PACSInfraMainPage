---
// Line icons for the system overview diagram. 24×24, stroke-based, inheriting currentColor.
export type IconName =
  | 'hospital' | 'scanner' | 'archive' | 'node' | 'upload'
  | 'cloud' | 'globe' | 'shield' | 'cpu' | 'images' | 'database' | 'bucket' | 'lock'
  | 'users' | 'monitor' | 'phone';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  hospital: 'M4 21V7l8-4 8 4v14M2 21h20M12 8v6M9 11h6M9 21v-4h6v4',
  scanner: 'M3 19h18M5 19v-3a7 7 0 0 1 14 0v3M12 12a3 3 0 1 0 0 .01M8 16h8',
