  phone: 'M7 2h10v20H7zM11 18h2',
};
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={className}>
  <path d={paths[name]} />
</svg>
