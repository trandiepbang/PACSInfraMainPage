---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line dark:divide-line-dark dark:border-line-dark">
  {items.map((item) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer items-start justify-between gap-6 font-medium">
        <span>{item.q}</span>
        <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true" class="mt-1 shrink-0 text-slate-400 transition group-open:rotate-45"><path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z" /></svg>
      </summary>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600 dark:text-slate-300">{item.a}</p>
    </details>
  ))}
</div>
