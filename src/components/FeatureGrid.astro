---
import { getLocale } from '../i18n';
import { product } from '../data/product';
import DiagramIcon from './DiagramIcon.astro';

const { features } = product[getLocale(Astro.url)];
---

<ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3 dark:border-line-dark dark:bg-line-dark">
  {features.map((f) => (
    <li class="bg-white p-6 dark:bg-night">
      <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-accent/10 text-accent dark:bg-accent-dark/15 dark:text-accent-dark">
        <DiagramIcon name={f.icon} size={22} />
      </span>
      <h3 class="mt-4 font-semibold">{f.title}</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{f.body}</p>
    </li>
  ))}
</ul>
