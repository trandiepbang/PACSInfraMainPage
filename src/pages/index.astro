---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Guarantees from '../components/Guarantees.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import ScreenshotPlaceholder from '../components/ScreenshotPlaceholder.astro';
import FoundingBanner from '../components/FoundingBanner.astro';
import StackOverview from '../components/StackOverview.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { pricing, site } from '../config';
import { billingLabel, formatPrice, lowestPrice } from '../lib/format';
import { summary, PIXEL_CAVEAT } from '../data/product';

const faq = [
  {
    q: 'Where does patient data live?',
    a: 'On your own server. PACSinfra is self-hosted: studies, reports and the audit trail stay on infrastructure you control.',
  },
  {
    q: 'What does de-identification cover?',
    a: `Patient identifiers are removed from DICOM metadata, including free-text fields and nested sequences, before anything reaches the image archive. ${PIXEL_CAVEAT}`,
  },
  {
    q: 'Can clinics still see real patient identities?',
    a: 'Yes. Clinics can keep real identities in a separate application database, apart from the image archive. Research teams can run on pseudonyms only.',
  },
  {
    q: 'How do you know one organisation cannot see another’s studies?',
    a: 'Tenant isolation is verified by an automated isolation test suite, and every image request passes through an API that checks permissions and records an audit entry.',
  },
  {
    q: 'What do we need to run it?',
    a: 'A single server that can run Docker Compose. PACSinfra deploys with one command, with nginx as the only public entry point.',
  },
  {
    q: 'Can we integrate it with our own systems?',
    a: 'Yes. PACSinfra has a full REST API with Swagger docs.',
  },
];
---

<BaseLayout description={`${site.description.trim()} Plans from ${lowestPrice()}.`}>
  <!-- Hero -->
  <section class="border-b border-line dark:border-line-dark">
    <div class="container-page py-20 sm:py-28">
      <p class="eyebrow">Self-hosted medical imaging</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight sm:text-6xl">
        Your imaging platform, on your own server.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl dark:text-slate-300">
        {site.name} is a self-hosted medical imaging platform built on Orthanc and OHIF. {summary}
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href={site.demoUrl} class="btn-primary">Try the demo</a>
        <a href="/pricing" class="btn-secondary">See pricing</a>
        <a href={site.bookingUrl} class="btn-secondary">Book a call</a>
      </div>
    </div>
  </section>

  <Section id="guarantees" eyebrow="Security" title="Built on two guarantees">
    <Guarantees />
  </Section>

  <Section id="features" tone="muted" eyebrow="What's included" title="Everything you need to store, review and report">
    <FeatureGrid />
  </Section>

  <Section id="architecture" eyebrow="Architecture" title="The image server is never exposed" intro="Your browser talks to the PACSinfra API. The API checks permissions, records an audit entry, then fetches images from Orthanc on a private network.">
    <ArchitectureDiagram />
  </Section>

  <Section id="screenshots" tone="muted" eyebrow="Product" title="A look inside">
    <div class="grid gap-8 md:grid-cols-3">
      <ScreenshotPlaceholder label="Study list with search and filters" />
      <ScreenshotPlaceholder label="Series and instance browsing" />
      <ScreenshotPlaceholder label="Report editor with PDF export" />
    </div>
  </Section>

  <Section id="stack" eyebrow="Technology" title="Built from proven open-source parts">
    <StackOverview />
  </Section>

  <Section id="pricing" tone="muted" eyebrow="Pricing" title="Buy once, run it yourself" intro={pricing.licenceSummary}>
    <div class="space-y-6">
      <FoundingBanner />
      <ul class="grid gap-4 md:grid-cols-[repeat(auto-fit,minmax(16rem,1fr))]">
        {pricing.tiers.map((t) => (
          <li class:list={['card', t.highlight && 'border-2 border-accent dark:border-accent-dark']}>
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-semibold">{t.name}</h3>
              {t.badge && <span class="text-xs font-semibold text-accent dark:text-accent-dark">{t.badge}</span>}
            </div>
            <p class="mt-3">
              <span class="text-3xl font-semibold tracking-tight">{formatPrice(t.price)}</span>
              <span class="ml-1 text-sm text-slate-500 dark:text-slate-400">{billingLabel(t.billing)}</span>
            </p>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{t.description}</p>
          </li>
        ))}
      </ul>
      <a href="/pricing" class="link inline-block text-sm">Compare plans and read the pricing FAQ &rarr;</a>
    </div>
  </Section>

  <Section id="faq" eyebrow="FAQ" title="Common questions">
    <Faq items={faq} />
    <p class="mt-6 text-sm text-slate-600 dark:text-slate-400">Questions about buying? See the <a href="/pricing#faq" class="link">pricing FAQ</a>.</p>
  </Section>

  <CtaBand />
</BaseLayout>
