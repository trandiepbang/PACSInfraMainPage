---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternatePath, getLocale, htmlLang, isTranslated } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  title?: string;
  fullTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const locale = getLocale(Astro.url);
// English pages that have a Chinese twin send first-time visitors whose browser prefers Chinese
// there. A choice made with the language button is stored and always wins.
const zhPath = locale === 'en' && isTranslated(Astro.url.pathname) ? alternatePath(Astro.url.pathname, 'zh-tw') : null;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...Astro.props} />
    {zhPath && (
      <script is:inline define:vars={{ zhPath }}>
        (() => {
          let chosen = null;
          try { chosen = localStorage.getItem('pacsinfra-lang'); } catch {}
          if (chosen === 'en') return;
          const prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          const wantsZh = chosen === 'zh-tw' || /^zh\b/i.test(prefs[0] || '');
          if (wantsZh) location.replace(zhPath + location.search + location.hash);
        })();
      </script>
    )}
    <!-- Same logic and storage key as Starlight, so the theme matches across the site and /docs. -->
    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('starlight-theme'); } catch {}
        const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">{ui[locale].nav.skip}</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
