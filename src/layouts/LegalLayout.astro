---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
}
const { title, description, updated = 'TODO' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container-page max-w-3xl py-16 sm:py-20">
    <h1 class="text-4xl font-semibold tracking-tight">{title}</h1>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Last updated: {updated}</p>
    <p class="mt-8 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200">
      Placeholder. This page has not been written yet and is not a legal document. Replace it with text reviewed by a lawyer before launch.
    </p>
    <div class="prose mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>
