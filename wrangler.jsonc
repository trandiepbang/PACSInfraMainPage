// Cloudflare Workers config: serves the static Astro build from dist/.
// Having this file stops `wrangler deploy` from auto-adding the @astrojs/cloudflare
// adapter (this site is fully static and doesn't need it).
{
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "pacsinfra-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
